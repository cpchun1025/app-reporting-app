# DATABASE_URL is optional and only intended for explicit overrides, such as
# an isolated SQLite test database. Leave it unset for the SQL Server settings
# below to be used.
# DATABASE_URL=
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_SA_USER=sa
# Changing this value does not change the password for an existing SQL Server
# named volume. Use a strong unique local development value.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
APP_DATABASE_NAME=trading_reporting
MSSQL_ENCRYPT=true
# Local Docker SQL Server uses a self-signed certificate. Set false when a
# trusted certificate is configured in a non-local environment.
MSSQL_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET=replace-this-development-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_DEV_USERS=true
# Development-only credentials used by the explicit seed command. Set unique
# local values; do not use these accounts in production.
DEV_ADMIN_PASSWORD=replace-with-a-local-admin-password
DEV_TRADER_PASSWORD=replace-with-a-local-trader-password
ENABLE_SCHEDULER=false
# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173
TRADE_SAVE_COPY_PATH=C:/scripts/trade-entry
# Date used only for idempotent local development daily-entry seed data.
DEVELOPMENT_BUSINESS_DATE=2026-09-22
