# SQL Server in docker-compose; SQLite is suitable for local smoke tests.
DATABASE_URL=mssql+pyodbc://sa:Your_strong_password123@sqlserver:1433/trading_reporting?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
JWT_SECRET=replace-this-development-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_DEV_USERS=true
ENABLE_SCHEDULER=false
# Comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173
TRADE_SAVE_COPY_PATH=C:/scripts/trade-entry
# Date used only for idempotent local development daily-entry seed data.
DEVELOPMENT_BUSINESS_DATE=2026-09-22
# Used by Docker Compose to start SQL Server. Change it before non-local use.
MSSQL_SA_PASSWORD=Your_strong_password123
